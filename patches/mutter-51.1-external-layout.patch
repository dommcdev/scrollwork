   gboolean needs_sync;
 };
@@ -602,12 +603,33 @@ do_sync_geometry (MetaWindowActorWayland *self)
   float surfaces_width, surfaces_height;
   float background_width, background_height;
 
+  if (self->external_clip && !meta_window_is_external_tiled (window))
+    {
+      clutter_actor_remove_clip (CLUTTER_ACTOR (self));
+      self->external_clip = FALSE;
+    }
+
   if (window->unmanaging)
     return FALSE;
 
   if (!clutter_actor_is_mapped (CLUTTER_ACTOR (actor)))
     return FALSE;
 
+  if (meta_window_is_external_tiled (window))
+    {
+      MtkRectangle frame_rect;
+      MtkRectangle buffer_rect;
+
+      meta_window_get_frame_rect (window, &frame_rect);
+      meta_window_get_buffer_rect (window, &buffer_rect);
+      clutter_actor_set_clip (CLUTTER_ACTOR (self),
+                              frame_rect.x - buffer_rect.x,
+                              frame_rect.y - buffer_rect.y,
+                              frame_rect.width,
+                              frame_rect.height);
+      self->external_clip = TRUE;
+    }
+
   if (maybe_configure_black_background (self,
                                         &surfaces_width, &surfaces_height,
                                         &background_width, &background_height))
diff --git a/src/core/window.c b/src/core/window.c
index c8bf540..c529d41 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -189,6 +189,7 @@ typedef struct _MetaWindowPrivate
   unsigned int mapped_inhibit_count;
 
   GHashTable *external_constraints;
+  gboolean external_tiled;
 
   MetaWindowConfig *pending_config;
 
@@ -3272,6 +3273,55 @@ update_edge_constraints (MetaWindow *window)
       window->edge_constraints.right = META_EDGE_CONSTRAINT_MONITOR;
       window->edge_constraints.left = META_EDGE_CONSTRAINT_MONITOR;
     }
+
+  if (((MetaWindowPrivate *) meta_window_get_instance_private (window))->external_tiled)
+    {
+      if (window->edge_constraints.top == META_EDGE_CONSTRAINT_NONE)
+        window->edge_constraints.top = META_EDGE_CONSTRAINT_WINDOW;
+      if (window->edge_constraints.right == META_EDGE_CONSTRAINT_NONE)
+        window->edge_constraints.right = META_EDGE_CONSTRAINT_WINDOW;
+      if (window->edge_constraints.bottom == META_EDGE_CONSTRAINT_NONE)
+        window->edge_constraints.bottom = META_EDGE_CONSTRAINT_WINDOW;
+      if (window->edge_constraints.left == META_EDGE_CONSTRAINT_NONE)
+        window->edge_constraints.left = META_EDGE_CONSTRAINT_WINDOW;
+    }
+}
+
+/**
+ * meta_window_set_external_tiled:
+ * @window: a #MetaWindow
+ * @tiled: whether an external layout tiles this window
+ *
+ * Advertises tiled edges without selecting Mutter's built-in tile geometry.
+ * An external constraint remains responsible for the window rectangle.
+ */
+void
+meta_window_set_external_tiled (MetaWindow *window,
+                                gboolean    tiled)
+{
+  MetaWindowPrivate *priv;
+
+  g_return_if_fail (META_IS_WINDOW (window));
+  priv = meta_window_get_instance_private (window);
+  tiled = !!tiled;
+  if (priv->external_tiled == tiled)
+    return;
+  priv->external_tiled = tiled;
+  update_edge_constraints (window);
+  if (meta_window_actor_from_window (window))
+    meta_compositor_sync_window_geometry (window->display->compositor,
+                                          window, FALSE);
+  meta_window_queue (window, META_QUEUE_MOVE_RESIZE);
+}
+
+gboolean
+meta_window_is_external_tiled (MetaWindow *window)
+{
+  MetaWindowPrivate *priv;
+
+  g_return_val_if_fail (META_IS_WINDOW (window), FALSE);
+  priv = meta_window_get_instance_private (window);
+  return priv->external_tiled;
 }
 
 gboolean
